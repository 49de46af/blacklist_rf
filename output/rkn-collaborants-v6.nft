# nftables blacklist
# Generated: 2026-11-16 16:43:46 UTC
# IPv4: 0, IPv6: 25
#
# Usage: sudo nft -f <this-file>
#   sudo nft add chain inet filter input '{ type filter hook input priority 0; policy accept; }'
#   sudo nft add rule inet filter input ip saddr @rkn_collaborants_v4 counter reject
#   sudo nft add rule inet filter input ip6 saddr @rkn_collaborants_v6 counter reject
#

table inet filter {

    set rkn_collaborants_v4 {
        type ipv4_addr
        flags interval
